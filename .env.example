# --- Supabase（15章）---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- サイト ---
APP_BASE_URL=https://order.t-eizou.com
# 16文字以上のランダムな文字列（openssl rand -base64 32 など）
CRON_SECRET=
UNSUBSCRIBE_SIGNING_SECRET=
IP_HASH_SECRET=

# --- 決済（Stripe）---
# stripe：本番・テスト環境 / fake：開発用の擬似決済（本番では起動しない）
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- メール（Amazon SES 東京）---
# ses：本番・テスト環境 / smtp：開発（Mailpit） / log：送らずにログだけ
MAIL_TRANSPORT=ses
AWS_REGION=ap-northeast-1
SES_CONFIGURATION_SET=tsuchida-order
SES_SNS_TOPIC_ARN=arn:aws:sns:ap-northeast-1:000000000000:tsuchida-order-ses-events
# テスト環境では、ここに書いたドメインのアドレスにだけ送る（カンマ区切り）
MAIL_ALLOWED_DOMAINS=
# SES の認証情報：SES の送信だけを許可した IAM ユーザーのアクセスキーを置く
# （AWS SDK の標準の読み込み順。Vercel の OIDC で IAM ロールを使う場合は @vercel/oidc-aws-credentials-provider を足す）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 開発（MAIL_TRANSPORT=smtp）：ローカルの Supabase に入っている Mailpit
# SMTP_URL=smtp://127.0.0.1:54325
